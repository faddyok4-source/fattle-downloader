# All 4 Render services
DOWNLOADER_ROLE=worker
WORKER_SECRET=CHANGE_ME
STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_BUCKET=fattle-downloads
STORAGE_ACCESS_KEY=...
STORAGE_SECRET_KEY=...
STORAGE_REGION=auto
MAX_FILE_BYTES=1900000000

# Render service #1 only (coordinator + worker)
DOWNLOADER_ROLE=coordinator_worker
DOWNLOADER_API_SECRET=CHANGE_ME_TOO
MONGODB_URI=mongodb+srv://...
MONGODB_DB=fattle_downloader
WORKER_1=https://worker1.onrender.com
WORKER_2=https://worker2.onrender.com
WORKER_3=https://worker3.onrender.com
WORKER_4=https://worker4.onrender.com

# Telegram delivery without a VPS
BOT_TOKEN=YOUR_EXISTING_BOT_TOKEN
ARCHIVE_CHAT_ID=-1001234567890
TELEGRAM_DIRECT_MAX_BYTES=49000000
R2_LINK_TTL_SECONDS=86400
ARCHIVE_LARGE_LINKS=true
DELETE_R2_AFTER_TELEGRAM_ARCHIVE=false

# Render #1 only: MTProto large-file archive upload
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=YOUR_TELEGRAM_API_HASH
TELEGRAM_MTPROTO_MAX_BYTES=1900000000
MTPROTO_R2_BUFFER_BYTES=8388608

# Public/authorized media extraction
YTDLP_FRAGMENT_CONCURRENCY=4
YTDLP_RETRIES=5

# Keep delivery inside Telegram. Set true only if you want R2 link fallback.
R2_FALLBACK_LINKS=false

# YouTube JavaScript runtime. Optional to override.
DENO_VERSION=v2.9.1
# DENO_BIN is auto-detected from .deno/bin/deno; normally leave unset.

# Maximum simultaneous coordinator jobs per process (excess requests get 429).
MAX_ACTIVE_JOBS=2

# ============================================================
# CLEAN PROVIDER ROUTER — Render #1 / coordinator only
# ============================================================

# YouTube: AHM7 primary, Prexzy automatic fallback.
# No signup or API key is required by either provider.
AHM7_API_URL=https://ahm7xmakki.com/api/alldl
PREXZY_API_URL=https://prexzyapis.com
YOUTUBE_PROVIDER_ORDER=ahm7,prexzy

# Instagram / TikTok -> Cobalt
COBALT_API_URL=https://your-cobalt-service.onrender.com
COBALT_API_KEY=

# TeraBox -> your TeraBox Gateway
TERABOX_API_URL=https://your-terabox-gateway.example.com

# Shared resolver behavior.
# Short timeout keeps fallback fast if a free provider is down.
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_RETRIES=3

# Recommended false because your Render yt-dlp path has already been blocked
# by source-site verification. Keeping it false exposes the real provider error.
PROVIDER_FALLBACK_YTDLP=false

# Provider streams with unknown size -> multipart R2 stream.
R2_STREAM_PART_BYTES=8388608


# ============================================================
# Resilient range downloading (all 4 Render downloader services)
# ============================================================
# Small chunks make provider/CDN disconnects cheap to retry.
RANGE_PART_BYTES=8388608

# Retry an interrupted byte-range request automatically.
WORKER_RANGE_RETRIES=4
WORKER_RANGE_RETRY_BACKOFF_SECONDS=1

# Retry whole-file stream from scratch when non-range CDN disconnects.
STREAM_DOWNLOAD_RETRIES=3

# ============================================================
# v3.4 stability settings
# ============================================================
# Retry sleeping/transient Render workers (502/503/504/network errors).
WORKER_CALL_RETRIES=4
WORKER_CALL_BACKOFF_SECONDS=1.5

# Best-effort Mongo status update retries. Downloads continue if a status write
# has a short transient failure.
MONGO_STATUS_RETRIES=2

# Deno is unnecessary while PROVIDER_FALLBACK_YTDLP=false.
INSTALL_DENO=auto

# Retry Telegram copyMessage/status/sendMessage on 429/5xx/network errors.
TELEGRAM_API_RETRIES=3


# ============================================================
# v3.6 speed settings — coordinator / Render #1
# ============================================================

# Hosted Telegram Bot API documents a 50 MB upload limit.
# If Telegram rejects a borderline file, Fattle automatically falls back to
# the existing MTProto archive path.
TELEGRAM_DIRECT_MAX_BYTES=52428800

# Larger R2 cache reduces range GETs while Telethon uploads.
MTPROTO_R2_BUFFER_BYTES=16777216

# One non-range source connection + concurrent R2 multipart uploads.
R2_STREAM_UPLOAD_WORKERS=3
R2_STREAM_INFLIGHT_PARTS=6


# ============================================================
# v3.7 true download + Telegram upload pipeline — Render #1
# ============================================================

# Start MTProto uploading while a single-stream source is still downloading.
LIVE_TELEGRAM_PIPELINE=true

# Skip the live pipeline for tiny files where the extra MTProto setup is not useful.
LIVE_TELEGRAM_MIN_BYTES=8388608

# 48 x 512 KiB = up to ~24 MiB queued if Telegram is temporarily slower.
LIVE_TELEGRAM_QUEUE_PARTS=48

# Maximum wait after source EOF for Telegram's remaining parts/message send.
LIVE_TELEGRAM_FINISH_TIMEOUT_SECONDS=1200
