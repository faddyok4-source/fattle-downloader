# All 4 Render services
DOWNLOADER_ROLE=worker
WORKER_SECRET=CHANGE_ME
STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_BUCKET=fattle-downloads
STORAGE_ACCESS_KEY=...
STORAGE_SECRET_KEY=...
STORAGE_REGION=auto
MAX_FILE_BYTES=1900000000

# Render service #1 only (coordinator + worker)
DOWNLOADER_ROLE=coordinator_worker
DOWNLOADER_API_SECRET=CHANGE_ME_TOO
MONGODB_URI=mongodb+srv://...
MONGODB_DB=fattle_downloader
WORKER_1=https://worker1.onrender.com
WORKER_2=https://worker2.onrender.com
WORKER_3=https://worker3.onrender.com
WORKER_4=https://worker4.onrender.com

# Telegram delivery without a VPS
BOT_TOKEN=YOUR_EXISTING_BOT_TOKEN
ARCHIVE_CHAT_ID=-1001234567890
TELEGRAM_DIRECT_MAX_BYTES=49000000
R2_LINK_TTL_SECONDS=86400
ARCHIVE_LARGE_LINKS=true
DELETE_R2_AFTER_TELEGRAM_ARCHIVE=false

# Render #1 only: MTProto large-file archive upload
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=YOUR_TELEGRAM_API_HASH
TELEGRAM_MTPROTO_MAX_BYTES=1900000000
MTPROTO_R2_BUFFER_BYTES=8388608

# Public/authorized media extraction
YTDLP_FRAGMENT_CONCURRENCY=4
YTDLP_RETRIES=5

# Keep delivery inside Telegram. Set true only if you want R2 link fallback.
R2_FALLBACK_LINKS=false

# YouTube JavaScript runtime. Optional to override.
DENO_VERSION=v2.9.1
# DENO_BIN is auto-detected from .deno/bin/deno; normally leave unset.

# Maximum simultaneous coordinator jobs per process (excess requests get 429).
MAX_ACTIVE_JOBS=2

# Optional multi-provider resolver layer (Render #1/coordinator only)
# Self-hosted Cobalt for YouTube / Instagram / TikTok / supported media sites.
COBALT_API_URL=https://your-cobalt-service.onrender.com
COBALT_API_KEY=YOUR_PRIVATE_COBALT_UUID_KEY

# Self-hosted TeraBox Gateway for public single-file share links.
TERABOX_API_URL=https://your-terabox-gateway.example.com

# Provider behavior. 429/4xx responses are not aggressively retried.
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_RETRIES=2
PROVIDER_FALLBACK_YTDLP=true
